{
    "name": "aymericcucherousset/d2-symfony",
    "description": "Render D2 diagrams (d2lang.com) in Symfony & Twig: local binary or Kroki, cached, profiler-ready.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "d2",
        "d2lang",
        "diagram",
        "svg",
        "symfony",
        "symfony-bundle",
        "twig",
        "kroki"
    ],
    "homepage": "https://github.com/aymericcucherousset/d2-symfony",
    "authors": [
        {
            "name": "Aymeric Cucherousset",
            "homepage": "https://github.com/aymericcucherousset"
        }
    ],
    "support": {
        "issues": "https://github.com/aymericcucherousset/d2-symfony/issues",
        "source": "https://github.com/aymericcucherousset/d2-symfony"
    },
    "require": {
        "php": ">=8.2",
        "ext-phar": "*",
        "ext-zlib": "*",
        "psr/cache": "^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/process": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "nyholm/symfony-bundle-test": "^3.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/cache": "^6.4 || ^7.4 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.4 || ^8.0",
        "twig/twig": "^3.21"
    },
    "conflict": {
        "twig/twig": "<3.21"
    },
    "suggest": {
        "symfony/twig-bundle": "To render diagrams in templates with the |d2 filter"
    },
    "autoload": {
        "psr-4": {
            "Aymericcucherousset\\D2Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aymericcucherousset\\D2Symfony\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=-1",
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "ci": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
