direction: right

template: "templates/page.html.twig" {
  shape: page
}
filter: "|d2 filter"
renderer: "Renderer" {
  binary: "BinaryRenderer"
}
d2: "d2 binary" {
  shape: hexagon
}
svg: "Inline SVG" {
  shape: document
}

template -> filter: "{{ source|d2 }}"
filter -> renderer.binary: Diagram
renderer.binary -> d2: "stdin"
d2 -> renderer.binary: "stdout"
renderer -> svg
